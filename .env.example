# Copy this file to .env and fill in your keys. .env is gitignored.

# Last.fm API key: https://www.last.fm/api/account/create
LAST_FM_API_KEY="your-lastfm-api-key"

# Google Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Gemini model. 'gemini-flash-latest' tracks the current free flash model.
# Avoid pinned gemini-2.0-flash / gemini-2.5-flash (blocked on new free keys).
GEMINI_MODEL="gemini-flash-latest"
